<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/app_desc"
            android:textSize="14sp"
            android:textColor="#888888" />

        <!-- Permission Warning Banner -->
        <LinearLayout
            android:id="@+id/layout_perm_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Write Permission Needed"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF3B30" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Permission to write system settings is required to update gesture width live."
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_grant_perm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant Permission" />
        </LinearLayout>

        <!-- Main Gesture Width Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gesture Edge Width"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_main_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="108 px"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0D84FF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_main_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="~39.3 dp (Stock MIUI: 54 px / ~20 dp)"
                android:textSize="13sp"
                android:textColor="#888888" />

            <!-- Slider: 50 to 200 px -->
            <SeekBar
                android:id="@+id/sb_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="50 px (Narrow)"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200 px (Wide)"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Presets Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Presets"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_preset_stock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Stock\n(54 px)"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_preset_default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Default\n(108 px)"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_preset_wide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Wide\n(140 px)"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_preset_max"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Max\n(200 px)"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Advanced: Separate Left & Right Edges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <Switch
                android:id="@+id/switch_separate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Separate Left and Right Edges"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_separate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Left Edge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Left Edge Width"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_left_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="108 px"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0D84FF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="14dp" />

                <!-- Right Edge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Right Edge Width"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_right_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="108 px"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0D84FF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Information & Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Changes apply live to MIUI Home.\nNo restart or reboot required."
                android:textSize="13sp"
                android:textColor="#34C759"
                android:lineSpacingMultiplier="1.2" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Reset to Default (108 px)" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
